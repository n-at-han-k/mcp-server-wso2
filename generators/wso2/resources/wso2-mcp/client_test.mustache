	// 404 means gone and 500 means broken; a model cannot tell them apart
	// from "an error".
	if apiErr.StatusCode != http.StatusNotFound || !strings.Contains(apiErr.Body, "ORG-60002") {
		t.Errorf("APIError = %+v", apiErr)
