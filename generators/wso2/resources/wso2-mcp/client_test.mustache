func TestCallFillsPathQueryAndBody(t *testing.T) {
	var seen *http.Request
	var body string

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		seen = r
		raw, _ := io.ReadAll(r.Body)
		body = string(raw)
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte(`{"id":"abc"}`))
	}))
	defer server.Close()

	tool := Tool{
		Name:        "update_organization",
		Method:      "PUT",
		Path:        "/organizations/{organization-id}",
		PathParams:  []string{"organization-id"},
		QueryParams: []string{"limit", "filter"},
		HasBody:     true,
	}

	out, err := NewClient(server.URL, false).Call(context.Background(), tool, args(map[string]string{
		"organization-id": `"o/1"`,
		"limit":           `10`,
		"body":            `{"name":"acme"}`,
	}))
	if err != nil {
		t.Fatalf("Call: %v", err)
	}

	// A path parameter is one segment: "o/1" must not become two.
	if seen.URL.EscapedPath() != "/organizations/o%2F1" {
		t.Errorf("path = %q", seen.URL.EscapedPath())
	}
	// A number is not quoted on its way into a query string, and a query
	// parameter nobody passed is not sent empty.
	if seen.URL.RawQuery != "limit=10" {
		t.Errorf("query = %q", seen.URL.RawQuery)
	}
	if body != `{"name":"acme"}` {
		t.Errorf("body = %q", body)
	}
	if out != `{"id":"abc"}` {
		t.Errorf("result = %q", out)
	}
