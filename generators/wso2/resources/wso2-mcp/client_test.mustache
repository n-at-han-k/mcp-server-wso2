func TestCallAnswersACreateWithNoBody(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Location", "https://is.example.com/api/server/v1/applications/7")
		w.WriteHeader(http.StatusCreated)
	}))
	defer server.Close()

	// WSO2 answers a create with 201 and nothing at all; the identifier is in
	// the header, and saying nothing back reads as a failure.
	out, err := NewClient(server.URL, false).Call(context.Background(),
		Tool{Name: "create_application", Method: "POST", Path: "/applications", HasBody: true},
		args(map[string]string{"body": `{"name":"acme"}`}))
	if err != nil {
		t.Fatalf("Call: %v", err)
	}
	if !strings.Contains(out, "/applications/7") || !strings.Contains(out, "201") {
		t.Errorf("result = %q", out)
	}
}

