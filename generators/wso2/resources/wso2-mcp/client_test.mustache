func TestCallKeepsTheStatus(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusNotFound)
		_, _ = w.Write([]byte(`{"code":"ORG-60002"}`))
	}))
	defer server.Close()

	_, err := NewClient(server.URL, false).Call(context.Background(),
		Tool{Name: "get_organization", Method: "GET", Path: "/organizations/x"}, nil)

	apiErr, ok := err.(*APIError)
	if !ok {
		t.Fatalf("error = %v, want *APIError", err)
